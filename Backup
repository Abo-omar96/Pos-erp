                <button onclick="closeModal('journalModal')" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form id="journalForm" onsubmit="saveManualJournal(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">بيان القيد / الشرح</label>
                    <input type="text" id="journalDesc" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="مثال: سداد مصروفات إدارية">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">الحساب المدين (من حـ/)</label>
                        <select id="journalDebitAcc" class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"></select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">الحساب الدائن (إلى حـ/)</label>
                        <select id="journalCreditAcc" class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"></select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">المبلغ</label>
                    <input type="number" id="journalAmount" step="0.01" min="1" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>
                <div class="flex justify-end space-x-2 space-x-reverse pt-2">
                    <button type="button" onclick="closeModal('journalModal')" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold">إلغاء</button>
                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold">اعتماد وترحيل القيد</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Hidden Printable Receipt Area -->
    <div id="printableInvoiceReceipt" class="hidden"></div>

    <!-- JavaScript ERP Engine -->
    <script>
        const defaultState = {
            accounts: [
                { code: '101', name: 'الصناديق وماكينات الدفع', category: 'Assets', type: 'Debit' },
                { code: '102', name: 'الذمم المدينة - العملاء', category: 'Assets', type: 'Debit' },
                { code: '103', name: 'المخزون (حوامل ومعدات MJK)', category: 'Assets', type: 'Debit' },
                { code: '201', name: 'الذمم الدائنة - الموردين', category: 'Liabilities', type: 'Credit' },
                { code: '301', name: 'مساهمات المستثمرين المسجلة', category: 'Equity', type: 'Credit' },
                { code: '302', name: 'رأس المال', category: 'Equity', type: 'Credit' },
                { code: '401', name: 'إيرادات المبيعات', category: 'Revenue', type: 'Credit' },
                { code: '501', name: 'تكلفة البضاعة المباعة (COGS)', category: 'Expenses', type: 'Debit' },
                { code: '502', name: 'المصروفات التشغيلية', category: 'Expenses', type: 'Debit' }
            ],
            products: [
                { code: 'MJK-01', name: 'حامل شاشة حائط MJK ثابت', spec: '32 - 55 بوصة', qty: 15, cost: 120, price: 220 },
                { code: 'MJK-02', name: 'حامل شاشة حائط MJK متحرك ذراعين', spec: '43 - 75 بوصة', qty: 8, cost: 350, price: 550 },
                { code: 'MJK-03', name: 'حامل شاشة سقفى MJK', spec: '55 - 85 بوصة', qty: 5, cost: 600, price: 950 }
            ],
            partners: [
                { id: 1, name: 'شركة التوحيد للتجارة', type: 'Customer', phone: '01011112222' },
                { id: 2, name: 'مؤسسة الهندسية للتوريدات', type: 'Supplier', phone: '01233334444' }
            ],
            sales: [],
            purchases: [],
            vouchers: [],
            journal: [
                { id: 1, date: '2026-10-01', desc: 'إثبات رأس المال ومساهمات المستثمرين والصناديق', debitAcc: '101', creditAcc: '302', amount: 50000 }
            ]
        };

        let appState = JSON.parse(localStorage.getItem('megabyte_erp_state')) || defaultState;
        let partnerTypeFilter = 'All';

        function saveState() {
            localStorage.setItem('megabyte_erp_state', JSON.stringify(appState));
            renderAll();
        }

        function resetSystemData() {
            if(confirm('هل أنت متأكد من إعادة تعيين البيانات للافتراضية؟')) {
                appState = JSON.parse(JSON.stringify(defaultState));
                saveState();
            }
        }

        // Backup & Restore
        function exportBackup() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `Megabyte_ERP_Backup_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importBackup(event) {
            const fileReader = new FileReader();
            if(event.target.files[0]) {
                fileReader.readAsText(event.target.files[0], "UTF-8");
                fileReader.onload = (e) => {
                    try {
                        appState = JSON.parse(e.target.result);
                        saveState();
                        alert('تم استرجاع النسخة الاحتياطية بنجاح!');
                    } catch (error) {
                        alert('ملف النسخة الاحتياطية غير صالح!');
                    }
                };
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            
            document.querySelectorAll('.tab-link').forEach(el => {
                el.classList.remove('bg-blue-600', 'text-white', 'font-semibold');
                el.classList.add('hover:bg-gray-800', 'hover:text-white');
            });
            event && event.currentTarget && event.currentTarget.classList.add('bg-blue-600', 'text-white', 'font-semibold');

            document.querySelectorAll('.mobile-nav-btn').forEach(el => {
                el.classList.remove('text-blue-400');
                if(el.getAttribute('data-tab') === tabId) el.classList.add('text-blue-400');
            });

            document.getElementById('sidebar').classList.add('translate-x-full');
        }

        document.getElementById('mobileMenuBtn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.toggle('translate-x-full');
        });
        document.getElementById('closeSidebarBtn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.add('translate-x-full');
        });

        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
            populateSelects();
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function getAccountBalance(accCode) {
            let balance = 0;
            appState.journal.forEach(j => {
                if(j.debitAcc === accCode) balance += Number(j.amount);
                if(j.creditAcc === accCode) balance -= Number(j.amount);
            });
            return balance;
        }

        function renderAll() {
            renderDashboard();
            renderCOA();
            renderInventory();
            renderPartners();
            renderSales();
            renderPurchases();
            renderVouchers();
            renderJournal();
            renderReports();
        }

        function renderDashboard() {
            let cash = Math.abs(getAccountBalance('101'));
            let receivables = Math.abs(getAccountBalance('102'));
            let payables = Math.abs(getAccountBalance('201'));
            let investors = Math.abs(getAccountBalance('301'));

            let netAssets = (receivables + cash) - (payables + investors);

            document.getElementById('kpi-net-assets').innerText = netAssets.toLocaleString() + ' ج.م';
            document.getElementById('kpi-cash').innerText = cash.toLocaleString() + ' ج.م';
            document.getElementById('kpi-receivables').innerText = receivables.toLocaleString() + ' ج.م';
            document.getElementById('kpi-payables').innerText = payables.toLocaleString() + ' ج.م';

            document.getElementById('eq-part1').innerText = (receivables + cash).toLocaleString() + ' ج.م';
            document.getElementById('eq-part2').innerText = (payables + investors).toLocaleString() + ' ج.م';
        }

        function renderCOA() {
            const tbody = document.getElementById('accountsTableBody');
            tbody.innerHTML = '';
            appState.accounts.forEach(acc => {
                let bal = getAccountBalance(acc.code);
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono font-bold text-blue-600">${acc.code}</td>
                        <td class="p-3 font-semibold">${acc.name}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded text-xs bg-gray-100">${acc.category}</span></td>
                        <td class="p-3">${acc.type === 'Debit' ? 'مدين' : 'دائن'}</td>
                        <td class="p-3 font-mono font-bold">${bal.toLocaleString()} ج.م</td>
                    </tr>
                `;
            });
        }

        function renderInventory() {
            const tbody = document.getElementById('inventoryTableBody');
            tbody.innerHTML = '';
            appState.products.forEach(p => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono text-xs text-blue-600">${p.code}</td>
                        <td class="p-3 font-semibold">${p.name}</td>
                        <td class="p-3 text-xs text-gray-600">${p.spec}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded text-xs ${p.qty > 3 ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'} font-bold">${p.qty} قطعة</span></td>
                        <td class="p-3 font-mono">${Number(p.cost).toLocaleString()} ج.م</td>
                        <td class="p-3 font-mono font-bold text-blue-700">${Number(p.price).toLocaleString()} ج.م</td>
                    </tr>
                `;
            });
        }

        let selectedPartnerId = null;
        function setPartnerTypeFilter(type) {
            partnerTypeFilter = type;
            ['All', 'Customer', 'Supplier'].forEach(t => {
                const btn = document.getElementById(`filter-btn-${t}`);
                if(btn) {
                    btn.className = (t === type) ? "flex-1 py-1 rounded bg-blue-600 text-white font-semibold" : "flex-1 py-1 rounded bg-gray-100 text-gray-600 font-semibold hover:bg-gray-200";
                }
            });
            renderPartners();
        }

        function renderPartners() {
            const container = document.getElementById('partnersListContainer');
            container.innerHTML = '';
            const searchQuery = (document.getElementById('partnerSearchInput')?.value || '').toLowerCase();

            let filteredPartners = appState.partners.filter(pt => {
                const matchesType = (partnerTypeFilter === 'All') || (pt.type === partnerTypeFilter);
                const matchesQuery = pt.name.toLowerCase().includes(searchQuery) || (pt.phone && pt.phone.includes(searchQuery));
                return matchesType && matchesQuery;
            });

            if(filteredPartners.length === 0) {
                container.innerHTML = `<div class="p-4 text-center text-xs text-gray-400">لا توجد جهات مطابقة للبحث</div>`;
                return;
            }

            filteredPartners.forEach(pt => {
                container.innerHTML += `
                    <div onclick="selectPartner(${pt.id})" class="p-3 rounded-lg border cursor-pointer hover:bg-blue-50 transition ${selectedPartnerId === pt.id ? 'border-blue-500 bg-blue-50/50' : 'border-gray-200'}">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-sm text-gray-800">${pt.name}</span>
                            <span class="text-[10px] px-2 py-0.5 rounded ${pt.type === 'Customer' ? 'bg-indigo-100 text-indigo-700' : 'bg-rose-100 text-rose-700'}">${pt.type === 'Customer' ? 'عميل' : 'مورد'}</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1"><i class="fa-solid fa-phone ml-1"></i> ${pt.phone || 'بدون هاتف'}</p>
                    </div>
                `;
            });
            if(selectedPartnerId) renderPartnerStatement(selectedPartnerId);
        }

        function selectPartner(id) {
            selectedPartnerId = id;
            renderPartners();
        }

        function renderPartnerStatement(id) {
            const partner = appState.partners.find(p => p.id === id);
            if(!partner) return;
            document.getElementById('statementTitle').innerText = `كشف حساب الجهة: ${partner.name} (${partner.type === 'Customer' ? 'عميل' : 'مورد'})`;
            
            const tbody = document.getElementById('statementTableBody');
            tbody.innerHTML = '';
            
            let runningBalance = 0;
            let transactions = [];

            if(partner.type === 'Customer') {
                appState.sales.filter(s => s.customer === partner.name).forEach(s => {
                    transactions.push({ date: s.date, desc: `فاتورة مبيعات رقم #${s.id}`, debit: s.total, credit: 0 });
                });
                appState.vouchers.filter(v => v.partner === partner.name && v.type === 'Receipt').forEach(v => {
                    transactions.push({ date: v.date, desc: `سند قبض رقم #${v.id} - ${v.desc}`, debit: 0, credit: v.amount });
                });
            } else {
                appState.purchases.filter(p => p.supplier === partner.name).forEach(p => {
                    transactions.push({ date: p.date, desc: `فاتورة مشتريات رقم #${p.id}`, debit: 0, credit: p.total });
                });
                appState.vouchers.filter(v => v.partner === partner.name && v.type === 'Payment').forEach(v => {
                    transactions.push({ date: v.date, desc: `سند صرف رقم #${v.id} - ${v.desc}`, debit: v.amount, credit: 0 });
                });
            }

            if(transactions.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-gray-400">لا توجد حركات مسجلة لهذه الجهة</td></tr>`;
                return;
            }

            transactions.forEach(tx => {
                runningBalance += (tx.debit - tx.credit);
                tbody.innerHTML += `
                    <tr>
                        <td class="p-2 font-mono">${tx.date}</td>
                        <td class="p-2">${tx.desc}</td>
                        <td class="p-2 font-mono text-emerald-600">${tx.debit ? tx.debit.toLocaleString() + ' ج.م' : '-'}</td>
                        <td class="p-2 font-mono text-rose-600">${tx.credit ? tx.credit.toLocaleString() + ' ج.م' : '-'}</td>
                        <td class="p-2 font-mono font-bold">${runningBalance.toLocaleString()} ج.م</td>
                    </tr>
                `;
            });
        }

        function printStatement() {
            if(!selectedPartnerId) { alert('الرجاء اختيار عميل أو مورد أولاً'); return; }
            window.print();
        }

        function filterSalesProducts() {
            const query = (document.getElementById('salesProductSearch').value || '').toLowerCase();
            const dropdown = document.getElementById('salesProductsDropdown');
            dropdown.innerHTML = '';
            
            const matches = appState.products.filter(p => 
                (p.code.toLowerCase().includes(query) || p.name.toLowerCase().includes(query) || p.spec.toLowerCase().includes(query)) && p.qty > 0
            );

            if(matches.length === 0) {
                dropdown.innerHTML = `<div class="p-2 text-xs text-gray-400 text-center">لا توجد أصناف مطابقة أو المخزون فارغ</div>`;
                dropdown.classList.remove('hidden');
                return;
            }

            matches.forEach(p => {
                let div = document.createElement('div');
                div.className = 'p-2.5 hover:bg-blue-50 cursor-pointer border-b border-gray-100 text-xs flex justify-between items-center';
                div.innerHTML = `
                    <div>
                        <span class="font-bold text-gray-800">${p.name}</span>
                        <span class="text-gray-500 block">كود: ${p.code} | المقاس: ${p.spec}</span>
                    </div>
                    <div class="text-left">
                        <span class="font-mono font-bold text-blue-600">${p.price} ج.م</span>
                        <span class="block text-[10px] text-emerald-600 font-bold">متاح: ${p.qty}</span>
                    </div>
                `;
                div.onclick = () => selectSaleProduct(p);
                dropdown.appendChild(div);
            });
            dropdown.classList.remove('hidden');
        }

        function selectSaleProduct(product) {
            document.getElementById('salesProductSearch').value = `${product.name} (${product.spec})`;
            document.getElementById('selectedSalesProductCode').value = product.code;
            document.getElementById('salesUnitPrice').value = product.price;
            document.getElementById('salesProductsDropdown').classList.add('hidden');
            calcSaleTotal();
        }

        function filterPurchasesProducts() {
            const query = (document.getElementById('purchasesProductSearch').value || '').toLowerCase();
            const dropdown = document.getElementById('purchasesProductsDropdown');
            dropdown.innerHTML = '';
            
            const matches = appState.products.filter(p => p.code.toLowerCase().includes(query) || p.name.toLowerCase().includes(query) || p.spec.toLowerCase().includes(query));

            if(matches.length === 0) {
                dropdown.innerHTML = `<div class="p-2 text-xs text-gray-400 text-center">لا توجد أصناف مطابقة</div>`;
                dropdown.classList.remove('hidden');
                return;
            }

            matches.forEach(p => {
                let div = document.createElement('div');
                div.className = 'p-2.5 hover:bg-emerald-50 cursor-pointer border-b border-gray-100 text-xs flex justify-between items-center';
                div.innerHTML = `
                    <div>
                        <span class="font-bold text-gray-800">${p.name}</span>
                        <span class="text-gray-500 block">كود: ${p.code} | المقاس: ${p.spec}</span>
                    </div>
                    <div class="text-left">
                        <span class="font-mono font-bold text-emerald-600">التكلفة: ${p.cost} ج.م</span>
                        <span class="block text-[10px] text-gray-500">الرصيد: ${p.qty}</span>
                    </div>
                `;
                div.onclick = () => selectPurchaseProduct(p);
                dropdown.appendChild(div);
            });
            dropdown.classList.remove('hidden');
        }

        function selectPurchaseProduct(product) {
            document.getElementById('purchasesProductSearch').value = `${product.name} (${product.spec})`;
            document.getElementById('selectedPurchasesProductCode').value = product.code;
            document.getElementById('purchasesUnitPrice').value = product.cost;
            document.getElementById('purchasesProductsDropdown').classList.add('hidden');
            calcPurchaseTotal();
        }

        document.addEventListener('click', (e) => {
            if(!e.target.closest('#salesProductSearch') && !e.target.closest('#salesProductsDropdown')) {
                const drop = document.getElementById('salesProductsDropdown');
                if(drop) drop.classList.add('hidden');
            }
            if(!e.target.closest('#purchasesProductSearch') && !e.target.closest('#purchasesProductsDropdown')) {
                const drop = document.getElementById('purchasesProductsDropdown');
                if(drop) drop.classList.add('hidden');
            }
        });

        function renderSales() {
            const tbody = document.getElementById('salesTableBody');
            tbody.innerHTML = '';
            appState.sales.forEach(s => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono font-bold text-blue-600">#${s.id}</td>
                        <td class="p-3 text-xs">${s.date}</td>
                        <td class="p-3 font-semibold">${s.customer}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded text-xs ${s.paymentType === 'Cash' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${s.paymentType === 'Cash' ? 'نقدي' : 'آجل'}</span></td>
                        <td class="p-3 font-mono font-bold">${s.total.toLocaleString()} ج.م</td>
                        <td class="p-3 space-x-2 space-x-reverse">
                            <button onclick="printSaleInvoice(${s.id})" class="text-blue-600 hover:text-blue-800 text-xs font-semibold"><i class="fa-solid fa-print"></i> طباعة</button>
                            <button onclick="deleteSale(${s.id})" class="text-red-500 hover:text-red-700 text-xs"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        function printSaleInvoice(id) {
            const sale = appState.sales.find(s => s.id === id);
            if(!sale) return;
            
            const receiptArea = document.getElementById('printableInvoiceReceipt');
            receiptArea.innerHTML = `
                <div style="font-family: 'Cairo', sans-serif; direction: rtl; padding: 20px; max-width: 400px; margin: auto; font-size: 14px;">
                    <div style="text-align: center; border-bottom: 2px dashed #333; padding-bottom: 10px; margin-bottom: 15px;">
                        <h2 style="margin: 0; font-size: 18px; font-weight: bold;">ميجابايت ستور</h2>
                        <p style="margin: 2px 0; font-size: 11px; color: #555;">لخدمات الكمبيوتر وحوامل الشاشات MJK</p>
                        <p style="margin: 2px 0; font-size: 11px; color: #555;">التاريخ: ${sale.date} | فاتورة رقم: #${sale.id}</p>
                    </div>
                    <div style="margin-bottom: 10px;">
                        <strong>العميل:</strong> ${sale.customer}<br>
                        <strong>طريقة الدفع:</strong> ${sale.paymentType === 'Cash' ? 'نقدي' : 'آجل'}
                    </div>
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12px;">
                        <thead>
                            <tr style="border-bottom: 1px solid #333;">
                                <th style="text-align: right; padding: 5px;">الصنف</th>
                                <th style="text-align: center; padding: 5px;">الكمية</th>
                                <th style="text-align: left; padding: 5px;">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding: 5px;">مشتريات حوامل/أجهزة MJK</td>
                                <td style="text-align: center; padding: 5px;">-</td>
                                <td style="text-align: left; padding: 5px;">${sale.total.toLocaleString()} ج.م</td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="border-top: 2px solid #333; padding-top: 8px; text-align: left; font-size: 15px; font-weight: bold;">
                        الإجمالي النهائي: ${sale.total.toLocaleString()} ج.م
                    </div>
                    <div style="text-align: center; margin-top: 20px; font-size: 11px; color: #777;">
                        شكراً لتعاملكم مع ميجابايت ستور
                    </div>
                </div>
            `;
            window.print();
        }

        function renderPurchases() {
            const tbody = document.getElementById('purchasesTableBody');
            tbody.innerHTML = '';
            appState.purchases.forEach(p => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 font-mono font-bold text-emerald-600">#${p.id}</td>
                        <td class="p-3 text-xs">${p.date}</td>
                        <td class="p-3 font-semibold">${p.supplier}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded text-xs ${p.paymentType === 'Cash' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${p.paymentType === 'Cash' ? 'نقدي' : 'آجل'}</span></td>
                        <td class="p-3 font-mono font-bold">${p.total.toLocaleString()} ج.م</td>
                        <td class="p-3"><button onclick="deletePurchase(${p.id})" class="text-red-500 hover:text-red-700 text-xs"><i class="fa-solid fa-trash"></i></button></td>
                    </tr>
                `;
            });
        }

        function renderVouchers() {
            const tbody = document.getElementById('vouchersTableBody');
            tbody.innerHTML = '';
            appState.vouchers.forEach(v => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50 text-xs">
                        <td class="p-3 font-mono font-bold text-blue-600">#${v.id}</td>
                        <td class="p-3">${v.date}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded ${v.type === 'Receipt' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">${v.type === 'Receipt' ? 'سند قبض' : 'سند صرف'}</span></td>
                        <td class="p-3 font-semibold">${v.partner}</td>
                        <td class="p-3 font-mono font-bold">${v.amount.toLocaleString()} ج.م</td>
                        <td class="p-3 text-gray-600">${v.desc}</td>
                    </tr>
                `;
            });
        }

        function renderJournal() {
            const tbody = document.getElementById('journalTableBody');
            tbody.innerHTML = '';
            appState.journal.forEach(j => {
                let debitAcc = appState.accounts.find(a => a.code === j.debitAcc)?.name || j.debitAcc;
                let creditAcc = appState.accounts.find(a => a.code === j.creditAcc)?.name || j.creditAcc;
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50 text-xs">
                        <td class="p-3 font-mono font-bold text-blue-600">#${j.id}</td>
                        <td class="p-3">${j.date}</td>
                        <td class="p-3 font-semibold">${j.desc}</td>
                        <td class="p-3 text-emerald-700"><i class="fa-solid fa-arrow-right ml-1"></i> ${debitAcc}</td>
                        <td class="p-3 text-rose-700"><i class="fa-solid fa-arrow-left ml-1"></i> ${creditAcc}</td>
                        <td class="p-3 font-mono font-bold">${Number(j.amount).toLocaleString()} ج.م</td>
                    </tr>
                `;
            });
        }

        function renderReports() {
            const tbBody = document.getElementById('trialBalanceBody');
            tbBody.innerHTML = '';
            appState.accounts.forEach(acc => {
                let bal = getAccountBalance(acc.code);
                let debitBal = bal > 0 ? bal : 0;
                let creditBal = bal < 0 ? Math.abs(bal) : 0;
                tbBody.innerHTML += `
                    <tr>
                        <td class="p-2 font-mono">${acc.code}</td>
                        <td class="p-2">${acc.name}</td>
                        <td class="p-2 font-mono text-emerald-600">${debitBal ? debitBal.toLocaleString() + ' ج.م' : '-'}</td>
                        <td class="p-2 font-mono text-rose-600">${creditBal ? creditBal.toLocaleString() + ' ج.م' : '-'}</td>
                        <td class="p-2 font-mono font-bold">${bal.toLocaleString()} ج.م</td>
                    </tr>
                `;
            });

            let revTotal = Math.abs(getAccountBalance('401'));
            let cogsTotal = Math.abs(getAccountBalance('501'));
            let expTotal = Math.abs(getAccountBalance('502'));
            let netProfit = revTotal - (cogsTotal + expTotal);

            document.getElementById('incomeStatementBox').innerHTML = `
                <div class="flex justify-between py-1 border-b"><span>إيرادات المبيعات:</span><span class="font-mono font-bold text-emerald-600">${revTotal.toLocaleString()} ج.م</span></div>
                <div class="flex justify-between py-1 border-b"><span>تكلفة البضاعة المباعة (COGS):</span><span class="font-mono font-bold text-rose-600">${cogsTotal.toLocaleString()} ج.م</span></div>
                <div class="flex justify-between py-1 border-b"><span>المصروفات التشغيلية:</span><span class="font-mono font-bold text-rose-600">${expTotal.toLocaleString()} ج.م</span></div>
                <div class="flex justify-between py-2 font-bold text-base bg-gray-50 px-2 rounded"><span>صافي الربح / (الخسارة):</span><span class="font-mono ${netProfit >= 0 ? 'text-emerald-600' : 'text-rose-600'}">${netProfit.toLocaleString()} ج.م</span></div>
            `;

            let assetsTotal = 0, liabilitiesTotal = 0, equityTotal = 0;
            appState.accounts.forEach(acc => {
                let bal = getAccountBalance(acc.code);
                if(acc.category === 'Assets') assetsTotal += bal;
                if(acc.category === 'Liabilities') liabilitiesTotal += Math.abs(bal);
                if(acc.category === 'Equity') equityTotal += Math.abs(bal);
            });

            document.getElementById('balanceSheetBox').innerHTML = `
                <div class="flex justify-between py-1 border-b"><span>إجمالي الأصول:</span><span class="font-mono font-bold text-blue-600">${assetsTotal.toLocaleString()} ج.م</span></div>
                <div class="flex justify-between py-1 border-b"><span>إجمالي الخصوم:</span><span class="font-mono font-bold text-rose-600">${liabilitiesTotal.toLocaleString()} ج.م</span></div>
                <div class="flex justify-between py-1 border-b"><span>إجمالي حقوق الملكية:</span><span class="font-mono font-bold text-indigo-600">${equityTotal.toLocaleString()} ج.م</span></div>
                <div class="flex justify-between py-2 font-bold text-base bg-gray-50 px-2 rounded"><span>تطابق الميزانية:</span><span class="font-mono text-emerald-600">متطابق</span></div>
            `;
        }

        function populateSelects() {
            const salesCust = document.getElementById('salesCustomer');
            const purSupp = document.getElementById('purchasesSupplier');
            const vPart = document.getElementById('voucherPartner');
            if(salesCust) salesCust.innerHTML = '';
            if(purSupp) purSupp.innerHTML = '';
            if(vPart) vPart.innerHTML = '';

            appState.partners.forEach(pt => {
                let opt = `<option value="${pt.name}">${pt.name} (${pt.type === 'Customer' ? 'عميل' : 'مورد'})</option>`;
                if(pt.type === 'Customer' && salesCust) salesCust.innerHTML += opt;
                if(pt.type === 'Supplier' && purSupp) purSupp.innerHTML += opt;
                if(vPart) vPart.innerHTML += opt;
            });

            const dAcc = document.getElementById('journalDebitAcc');
            const cAcc = document.getElementById('journalCreditAcc');
            if(dAcc && cAcc) {
                dAcc.innerHTML = '';
                cAcc.innerHTML = '';
                appState.accounts.forEach(acc => {
                    let opt = `<option value="${acc.code}">${acc.code} - ${acc.name}</option>`;
                    dAcc.innerHTML += opt;
                    cAcc.innerHTML += opt;
                });
            }
        }

        function calcSaleTotal() {
            let qty = Number(document.getElementById('salesQty').value) || 0;
            let price = Number(document.getElementById('salesUnitPrice').value) || 0;
            document.getElementById('salesTotalDisplay').innerText = (qty * price).toLocaleString() + ' ج.م';
        }

        function calcPurchaseTotal() {
            let qty = Number(document.getElementById('purchasesQty').value) || 0;
            let price = Number(document.getElementById('purchasesUnitPrice').value) || 0;
            document.getElementById('purchasesTotalDisplay').innerText = (qty * price).toLocaleString() + ' ج.م';
        }

        function saveAccount(e) {
            e.preventDefault();
            appState.accounts.push({
                code: document.getElementById('accCode').value,
                name: document.getElementById('accName').value,
                category: document.getElementById('accCategory').value,
                type: 'Debit'
            });
            saveState();
            closeModal('accountModal');
            document.getElementById('accountForm').reset();
        }

        function saveProduct(e) {
            e.preventDefault();
            appState.products.push({
                code: document.getElementById('prodCode').value,
                name: document.getElementById('prodName').value,
                spec: document.getElementById('prodSpec').value,
                qty: Number(document.getElementById('prodQty').value),
                cost: Number(document.getElementById('prodCost').value),
                price: Number(document.getElementById('prodPrice').value)
            });
            saveState();
            closeModal('productModal');
            document.getElementById('productForm').reset();
        }

        function savePartner(e) {
            e.preventDefault();
            appState.partners.push({
                id: Date.now(),
                name: document.getElementById('partName').value,
                type: document.getElementById('partType').value,
                phone: document.getElementById('partPhone').value
            });
            saveState();
            closeModal('partnerModal');
            document.getElementById('partnerForm').reset();
        }

        function saveSalesInvoice(e) {
            e.preventDefault();
            let prodCode = document.getElementById('selectedSalesProductCode').value;
            let qty = Number(document.getElementById('salesQty').value);
            let unitPrice = Number(document.getElementById('salesUnitPrice').value);
            let customer = document.getElementById('salesCustomer').value;
            let paymentType = document.getElementById('salesPaymentType').value;

            if(!prodCode) { alert('الرجاء اختيار صنف من قائمة البحث!'); return; }

            let product = appState.products.find(p => p.code === prodCode);
            if(!product || product.qty < qty) { alert('الكمية المطلوبة غير متوفرة في المخزون!'); return; }

            let totalCost = qty * product.cost;
            product.qty -= qty;

            let totalSale = qty * unitPrice;
            let invoiceId = Date.now();
            let today = new Date().toISOString().split('T')[0];

            appState.sales.push({ id: invoiceId, date: today, customer, paymentType, total: totalSale });

            let cashOrReceivableAcc = paymentType === 'Cash' ? '101' : '102';
            appState.journal.push({
                id: Date.now() + 1, date: today, desc: `إثبات فاتورة مبيعات رقم #${invoiceId} للعميل ${customer}`,
                debitAcc: cashOrReceivableAcc, creditAcc: '401', amount: totalSale
            });

            appState.journal.push({
                id: Date.now() + 2, date: today, desc: `إثبات تكلفة بضاعة مباعة لفاتورة #${invoiceId}`,
                debitAcc: '501', creditAcc: '103', amount: totalCost
            });

            saveState();
            closeModal('salesModal');
            document.getElementById('salesProductSearch').value = '';
            document.getElementById('selectedSalesProductCode').value = '';
        }

        function savePurchasesInvoice(e) {
            e.preventDefault();
            let prodCode = document.getElementById('selectedPurchasesProductCode').value;
            let qty = Number(document.getElementById('purchasesQty').value);
            let unitPrice = Number(document.getElementById('purchasesUnitPrice').value);
            let supplier = document.getElementById('purchasesSupplier').value;
            let paymentType = document.getElementById('purchasesPaymentType').value;

            if(!prodCode) { alert('الرجاء اختيار صنف شراء من قائمة البحث!'); return; }

            let product = appState.products.find(p => p.code === prodCode);
            if(!product) return;

            let oldTotalVal = product.qty * product.cost;
            let newBatchVal = qty * unitPrice;
            let newTotalQty = product.qty + qty;
            product.cost = newTotalQty > 0 ? (oldTotalVal + newBatchVal) / newTotalQty : unitPrice;
            product.qty = newTotalQty;

            let totalPurchase = qty * unitPrice;
            let invoiceId = Date.now();
            let today = new Date().toISOString().split('T')[0];

            appState.purchases.push({ id: invoiceId, date: today, supplier, paymentType, total: totalPurchase });

            let cashOrPayableAcc = paymentType === 'Cash' ? '101' : '201';
            appState.journal.push({
                id: Date.now() + 1, date: today, desc: `إثبات فاتورة مشتريات رقم #${invoiceId} من المورد ${supplier}`,
                debitAcc: '103', creditAcc: cashOrPayableAcc, amount: totalPurchase
            });

            saveState();
            closeModal('purchasesModal');
            document.getElementById('purchasesProductSearch').value = '';
            document.getElementById('selectedPurchasesProductCode').value = '';
        }

        function saveVoucher(e) {
            e.preventDefault();
            let type = document.getElementById('voucherType').value;
            let partner = document.getElementById('voucherPartner').value;
            let amount = Number(document.getElementById('voucherAmount').value);
            let desc = document.getElementById('voucherDesc').value;
            let voucherId = Date.now();
            let today = new Date().toISOString().split('T')[0];

            appState.vouchers.push({ id: voucherId, date: today, type, partner, amount, desc });

            if(type === 'Receipt') {
                // From Cash/Machine to Customer (reduces receivables)
                appState.journal.push({
                    id: Date.now() + 1, date: today, desc: `سند قبض #${voucherId} - ${desc}`,
                    debitAcc: '101', creditAcc: '102', amount: amount
                });
            } else {
                // From Supplier to Cash (reduces payables)
                appState.journal.push({
                    id: Date.now() + 1, date: today, desc: `سند صرف #${voucherId} - ${desc}`,
                    debitAcc: '201', creditAcc: '101', amount: amount
                });
            }

            saveState();
            closeModal('voucherModal');
            document.getElementById('voucherForm').reset();
        }

        function saveManualJournal(e) {
            e.preventDefault();
            let debitAcc = document.getElementById('journalDebitAcc').value;
            let creditAcc = document.getElementById('journalCreditAcc').value;
            let amount = Number(document.getElementById('journalAmount').value);

            if(debitAcc === creditAcc) { alert('لا يمكن أن يكون الحساب المدين مطابقاً للحساب الدائن!'); return; }

            appState.journal.push({
                id: Date.now(), date: new Date().toISOString().split('T')[0],
                desc: document.getElementById('journalDesc').value, debitAcc, creditAcc, amount
            });

            saveState();
            closeModal('journalModal');
            document.getElementById('journalForm').reset();
        }

        function deleteSale(id) {
            if(confirm('هل أنت متأكد من حذف الفاتورة؟')) {
                appState.sales = appState.sales.filter(s => s.id !== id);
                saveState();
            }
        }

        function deletePurchase(id) {
            if(confirm('هل أنت متأكد من حذف الفاتورة؟')) {
                appState.purchases = appState.purchases.filter(p => p.id !== id);
                saveState();
            }
        }

        renderAll();
    </script>
</body>
</html>
