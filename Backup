
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ميجابايت ستور - نظام ERP المحاسبي المتكامل</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1e40af',
                        secondary: '#0f172a',
                        accent: '#2563eb'
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; }
        @media print {
            body * { visibility: hidden; }
            #printableArea, #printableArea *, #printableAreaStatement, #printableAreaStatement *, #printableInvoiceReceipt, #printableInvoiceReceipt * { visibility: visible; }
            #printableAreaStatement, #printableInvoiceReceipt { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased min-h-screen flex flex-col">

    <!-- Navbar / Header -->
    <header class="bg-secondary text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3 space-x-reverse">
                <button id="mobileMenuBtn" class="md:hidden text-white focus:outline-none text-xl p-1">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="bg-blue-600 p-2 rounded-lg text-white font-bold text-lg shadow">
                    <i class="fa-solid fa-server"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">ميجابايت ستور</h1>
                    <p class="text-xs text-gray-400">نظام إدارة الموارد والأصول (ERP)</p>
                </div>
            </div>
            <div class="flex items-center space-x-3 space-x-reverse">
                <button onclick="exportBackup()" class="text-xs bg-blue-700 hover:bg-blue-800 text-white px-2.5 py-1.5 rounded transition flex items-center" title="تصدير نسخة احتياطية">
                    <i class="fa-solid fa-download ml-1"></i> <span class="hidden sm:inline">نسخة احتياطية</span>
                </button>
                <label class="text-xs bg-indigo-700 hover:bg-indigo-800 text-white px-2.5 py-1.5 rounded transition cursor-pointer flex items-center" title="استرجاع نسخة احتياطية">
                    <i class="fa-solid fa-upload ml-1"></i> <span class="hidden sm:inline">استرجاع</span>
                    <input type="file" id="importFile" accept=".json" onchange="importBackup(event)" class="hidden">
                </label>
                <button onclick="resetSystemData()" class="text-xs bg-red-600/80 hover:bg-red-700 text-white px-2.5 py-1.5 rounded transition" title="إعادة تعيين البيانات الافتراضية">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main App Container -->
    <div class="flex-1 flex flex-col md:flex-row max-w-7xl w-full mx-auto">

        <!-- Sidebar / Drawer -->
        <aside id="sidebar" class="fixed inset-y-0 right-0 z-40 w-64 bg-secondary text-gray-300 transform translate-x-full md:translate-x-0 md:static md:inset-auto transition-transform duration-300 ease-in-out flex flex-col shadow-xl md:shadow-none no-print">
            <div class="p-4 border-b border-gray-800 flex justify-between items-center md:hidden">
                <span class="font-bold text-white">القائمة الرئيسية</span>
                <button id="closeSidebarBtn" class="text-gray-400 hover:text-white text-lg"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <nav class="flex-1 px-3 py-4 space-y-1.5 overflow-y-auto text-sm">
                <a href="#" onclick="switchTab('dashboard')" class="tab-link flex items-center px-3 py-2.5 rounded-lg text-white bg-blue-600 font-semibold transition">
                    <i class="fa-solid fa-chart-pie w-6 ml-2"></i> لوحة المؤشرات
                </a>
                <a href="#" onclick="switchTab('coa')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-sitemap w-6 ml-2"></i> دليل الحسابات (COA)
                </a>
                <a href="#" onclick="switchTab('inventory')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-boxes-stacked w-6 ml-2"></i> إدارة المخزون و MJK
                </a>
                <a href="#" onclick="switchTab('partners')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-address-book w-6 ml-2"></i> العملاء والموردين
                </a>
                <a href="#" onclick="switchTab('sales')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-file-invoice-dollar w-6 ml-2"></i> فواتير المبيعات
                </a>
                <a href="#" onclick="switchTab('purchases')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-cart-shopping w-6 ml-2"></i> فواتير المشتريات
                </a>
                <a href="#" onclick="switchTab('vouchers')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-receipt w-6 ml-2"></i> سندات القبض والصرف
                </a>
                <a href="#" onclick="switchTab('journal')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-book-journal-whills w-6 ml-2"></i> القيود المزدوجة اليومية
                </a>
                <a href="#" onclick="switchTab('reports')" class="tab-link flex items-center px-3 py-2.5 rounded-lg hover:bg-gray-800 hover:text-white transition">
                    <i class="fa-solid fa-chart-column w-6 ml-2"></i> التقارير والختاميات
                </a>
            </nav>
            <div class="p-4 border-t border-gray-800 text-xs text-gray-500 text-center">
                إصدار الـ ERP المحاسبي 4.0 &copy; 2026
            </div>
        </aside>

        <!-- Content Area -->
        <main class="flex-1 p-4 md:p-6 overflow-y-auto pb-20 md:pb-6">

            <!-- 1. DASHBOARD TAB -->
            <section id="tab-dashboard" class="space-y-6 tab-content">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">لوحة المؤشرات والملخص المالي</h2>
                    <span class="text-xs text-gray-500">تحديث مباشر للحسابات</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">إجمالي الأصول الصافية</p>
                                <h3 id="kpi-net-assets" class="text-xl font-bold text-blue-600 mt-1">0.00 ج.م</h3>
                            </div>
                            <div class="bg-blue-50 p-2.5 rounded-lg text-blue-600"><i class="fa-solid fa-scale-balanced"></i></div>
                        </div>
                        <p class="text-[11px] text-gray-400 mt-2">(العملاء + الصناديق) - (الموردين + المستثمرين)</p>
                    </div>

                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">الصناديق والماكينات النقدية</p>
                                <h3 id="kpi-cash" class="text-xl font-bold text-emerald-600 mt-1">0.00 ج.م</h3>
                            </div>
                            <div class="bg-emerald-50 p-2.5 rounded-lg text-emerald-600"><i class="fa-solid fa-vault"></i></div>
                        </div>
                        <p class="text-[11px] text-gray-400 mt-2">النقدية الفعلية وماكينات الدفع</p>
                    </div>

                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">الذمم المدينة (لنا عند العملاء)</p>
                                <h3 id="kpi-receivables" class="text-xl font-bold text-indigo-600 mt-1">0.00 ج.م</h3>
                            </div>
                            <div class="bg-indigo-50 p-2.5 rounded-lg text-indigo-600"><i class="fa-solid fa-user-clock"></i></div>
                        </div>
                        <p class="text-[11px] text-gray-400 mt-2">مستحقات الفواتير الآجلة للعملاء</p>
                    </div>

                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">الذمم الدائنة (علينا للموردين)</p>
                                <h3 id="kpi-payables" class="text-xl font-bold text-rose-600 mt-1">0.00 ج.م</h3>
                            </div>
                            <div class="bg-rose-50 p-2.5 rounded-lg text-rose-600"><i class="fa-solid fa-file-invoice"></i></div>
                        </div>
                        <p class="text-[11px] text-gray-400 mt-2">التزامات بضائع الموردين المفتوحة</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
                        <h3 class="font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-bolt text-amber-500 ml-2"></i> اختصارات سريعة</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="switchTab('sales')" class="p-3 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg text-sm font-semibold text-right transition flex items-center">
                                <i class="fa-solid fa-cash-register ml-2 text-lg"></i> إصدار فاتورة بيع
                            </button>
                            <button onclick="switchTab('vouchers')" class="p-3 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-lg text-sm font-semibold text-right transition flex items-center">
                                <i class="fa-solid fa-receipt ml-2 text-lg"></i> سند قبض / صرف
                            </button>
                            <button onclick="switchTab('inventory')" class="p-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg text-sm font-semibold text-right transition flex items-center">
                                <i class="fa-solid fa-box-open ml-2 text-lg"></i> إضافة صنف MJK جديد
                            </button>
                            <button onclick="switchTab('journal')" class="p-3 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-lg text-sm font-semibold text-right transition flex items-center">
                                <i class="fa-solid fa-pen-to-square ml-2 text-lg"></i> قيد يومية يدوي مزدوج
                            </button>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
                        <h3 class="font-bold text-gray-800 mb-4 flex items-center"><i class="fa-solid fa-shield-halved text-blue-600 ml-2"></i> معادلة صافي الأصول المعتمدة</h3>
                        <div class="bg-gray-50 p-3.5 rounded-lg text-xs space-y-2 border border-gray-200 font-mono">
                            <div class="text-blue-700 font-bold">صافي الأصول = (العملاء + الصناديق والماكينات) - (الموردين + مساهمات المستثمرين)</div>
                            <div class="text-gray-600 flex justify-between pt-1 border-t border-gray-200">
                                <span>+ إجمالي العملاء والصناديق:</span>
                                <span id="eq-part1" class="font-bold">0.00 ج.م</span>
                            </div>
                            <div class="text-gray-600 flex justify-between">
                                <span>- إجمالي الموردين والمستثمرين:</span>
                                <span id="eq-part2" class="font-bold">0.00 ج.م</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. CHART OF ACCOUNTS TAB -->
            <section id="tab-coa" class="space-y-6 tab-content hidden">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">دليل الحسابات (Chart of Accounts)</h2>
                    <button onclick="openModal('accountModal')" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center">
                        <i class="fa-solid fa-plus ml-1.5"></i> إضافة حساب فرعي
                    </button>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-100 text-gray-700 font-semibold border-b">
                                <tr>
                                    <th class="p-3">رقم الحساب</th>
                                    <th class="p-3">اسم الحساب</th>
                                    <th class="p-3">التصنيف الرئيسي</th>
                                    <th class="p-3">الطبيعة</th>
                                    <th class="p-3">الرصيد الحالي</th>
                                </tr>
                            </thead>
                            <tbody id="accountsTableBody" class="divide-y divide-gray-200">
                                <!-- JS Populated -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 3. INVENTORY & MJK BRACKETS TAB -->
            <section id="tab-inventory" class="space-y-6 tab-content hidden">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">إدارة المخزون وحوامل شاشات MJK</h2>
                    <button onclick="openModal('productModal')" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center">
                        <i class="fa-solid fa-plus ml-1.5"></i> إضافة صنف جديد
                    </button>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-100 text-gray-700 font-semibold border-b">
                                <tr>
                                    <th class="p-3">كود الصنف</th>
                                    <th class="p-3">اسم الصنف والمواصفات (MJK)</th>
                                    <th class="p-3">مقاس الشاشة / VESA</th>
                                    <th class="p-3">الكمية المتاحة</th>
                                    <th class="p-3">متوسط التكلفة</th>
                                    <th class="p-3">سعر البيع</th>
                                </tr>
                            </thead>
                            <tbody id="inventoryTableBody" class="divide-y divide-gray-200">
                                <!-- JS Populated -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 4. PARTNERS (CUSTOMERS & SUPPLIERS) TAB -->
            <section id="tab-partners" class="space-y-6 tab-content hidden">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">سجل العملاء والموردين وكشوف الحسابات</h2>
                    <button onclick="openModal('partnerModal')" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center">
                        <i class="fa-solid fa-user-plus ml-1.5"></i> إضافة عميل / مورد
                    </button>
                </div>
                
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 lg:col-span-1 space-y-3">
                        <h3 class="font-bold text-gray-800 text-sm">دليل العملاء والموردين</h3>
                        
                        <div class="space-y-2">
                            <div class="relative">
                                <input type="text" id="partnerSearchInput" oninput="renderPartners()" placeholder="بحث بالاسم أو رقم الهاتف..." class="w-full border rounded-lg pr-8 pl-2 py-1.5 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                <i class="fa-solid fa-magnifying-glass absolute right-2.5 top-2.5 text-gray-400 text-xs"></i>
                            </div>
                            <div class="flex gap-1 text-[11px]">
                                <button onclick="setPartnerTypeFilter('All')" id="filter-btn-All" class="flex-1 py-1 rounded bg-blue-600 text-white font-semibold">الكل</button>
                                <button onclick="setPartnerTypeFilter('Customer')" id="filter-btn-Customer" class="flex-1 py-1 rounded bg-gray-100 text-gray-600 font-semibold hover:bg-gray-200">العملاء</button>
                                <button onclick="setPartnerTypeFilter('Supplier')" id="filter-btn-Supplier" class="flex-1 py-1 rounded bg-gray-100 text-gray-600 font-semibold hover:bg-gray-200">الموردين</button>
                            </div>
                        </div>

                        <div id="partnersListContainer" class="space-y-2 max-h-96 overflow-y-auto pt-1">
                            <!-- JS populated -->
                        </div>
                    </div>
                    
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 lg:col-span-2">
                        <div class="flex justify-between items-center mb-4 pb-2 border-b">
                            <h3 id="statementTitle" class="font-bold text-gray-800 text-sm">اختر عميل أو مورد لعرض كشف الحساب</h3>
                            <button onclick="printStatement()" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded font-semibold"><i class="fa-solid fa-print ml-1"></i> طباعة كشف الحساب</button>
                        </div>
                        <div id="printableAreaStatement" class="overflow-x-auto">
                            <table class="w-full text-right text-xs">
                                <thead class="bg-gray-100 text-gray-700 border-b">
                                    <tr>
                                        <th class="p-2">التاريخ</th>
                                        <th class="p-2">البيان / المعاملة</th>
                                        <th class="p-2">مدين</th>
                                        <th class="p-2">دائن</th>
                                        <th class="p-2">الرصيد التراكمي</th>
                                    </tr>
                                </thead>
                                <tbody id="statementTableBody" class="divide-y divide-gray-200">
                                    <tr><td colspan="5" class="text-center py-6 text-gray-400">لم يتم اختيار جهة</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. SALES INVOICES TAB -->
            <section id="tab-sales" class="space-y-6 tab-content hidden">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">إدارة فواتير المبيعات ونقاط البيع</h2>
                    <button onclick="openModal('salesModal')" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center">
                        <i class="fa-solid fa-plus ml-1.5"></i> فاتورة بيع جديدة
                    </button>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-100 text-gray-700 font-semibold border-b">
                                <tr>
                                    <th class="p-3">رقم الفاتورة</th>
                                    <th class="p-3">التاريخ</th>
                                    <th class="p-3">العميل</th>
                                    <th class="p-3">طريقة الدفع</th>
                                    <th class="p-3">الإجمالي</th>
                                    <th class="p-3">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="salesTableBody" class="divide-y divide-gray-200">
                                <!-- JS Populated -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 6. PURCHASES INVOICES TAB -->
            <section id="tab-purchases" class="space-y-6 tab-content hidden">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">فواتير ومشتريات البضائع</h2>
                    <button onclick="openModal('purchasesModal')" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center">
                        <i class="fa-solid fa-plus ml-1.5"></i> فاتورة شراء جديدة
                    </button>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-100 text-gray-700 font-semibold border-b">
                                <tr>
                                    <th class="p-3">رقم الفاتورة</th>
                                    <th class="p-3">التاريخ</th>
                                    <th class="p-3">المورد</th>
                                    <th class="p-3">طريقة السداد</th>
                                    <th class="p-3">الإجمالي</th>
                                    <th class="p-3">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="purchasesTableBody" class="divide-y divide-gray-200">
                                <!-- JS Populated -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 7. CASH RECEIPTS & PAYMENTS VOUCHERS TAB -->
            <section id="tab-vouchers" class="space-y-6 tab-content hidden">
                <div class="flex justify-between items-center">
                    <h2 class="text-xl font-bold text-gray-900">سندات القبض والصرف النقدية</h2>
                    <button onclick="openModal('voucherModal')" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center">
                        <i class="fa-solid fa-plus ml-1.5"></i> سند جديد (قبض / صرف)
                    </button>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead class="bg-gray-100 text-gray-700 font-semibold border-b">
                                <tr>
                                    <th class="p-3">رقم السند</th>
                                    <th class="p-3">التاريخ</th>
                                    <th class="p-3">نوع السند</th>
                                    <th class="p-3">الجهة (عميل / مورد / مستثمر)</th>
                                    <th class="p-3">المبلغ</th>
                                    <th class="p-3">البيان</th>
                                </tr>
                            </thead>
